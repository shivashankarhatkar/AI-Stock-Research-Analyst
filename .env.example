# Copy this file to `.env` and fill in your keys.  (Never share your .env file!)

# --- Google Gemini ---------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Optional: change the model
GEMINI_MODEL=gemini-3.5-flash

# --- LangSmith tracing -----------------------------------------------------
# Get a key at https://smith.langchain.com  (Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stock-research-analyst
# Only needed if your LangSmith account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
